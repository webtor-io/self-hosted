USE_PPROF=false
USE_PROBE=false
USE_PROM=false
DATA_DIR=${DATA_DIR:-/data}
STORAGE_DIR=${STORAGE_DIR:-/storage}
S3_SERVICE_HOST=127.0.0.1
S3_SERVICE_PORT=8099
USE_LOCALS3=${USE_LOCALS3:-true}
AWS_ENDPOINT=${AWS_ENDPOINT:-http://127.0.0.1:8099}
AWS_REGION=${AWS_REGION:-us-east-1}
AWS_NO_SSL=${AWS_NO_SSL:-true}
AWS_POSTER_CACHE_BUCKET=${AWS_POSTER_CACHE_BUCKET:-posters}
AWS_USER_SUBTITLE_BUCKET=${AWS_USER_SUBTITLE_BUCKET:-subtitles}
AWS_THUMBNAIL_BUCKET=${AWS_THUMBNAIL_BUCKET:-thumbnails}
TORRENT_STORE_SERVICE_PORT=50051
TORRENT_STORE_SERVICE_HOST=127.0.0.1
MAGNET2TORRENT_SERVICE_PORT=50052
MAGNET2TORRENT_SERVICE_HOST=127.0.0.1
# Open trackers used by magnet2torrent while resolving a magnet (announced on
# top of the magnet's own) and by torrent-store when a torrent is pushed
# (merged into non-private torrents, deduplicated). Comma-separated. Set to an
# empty string to disable both. Same list production runs with.
DEFAULT_TRACKERS=${DEFAULT_TRACKERS:-udp://tracker.opentrackr.org:1337/announce,udp://open.demonii.com:1337/announce,udp://open.stealth.si:80/announce,udp://tracker.torrent.eu.org:451/announce,udp://tracker.qu.ax:6969/announce,udp://bittorrent-tracker.e-n-c-r-y-p-t.net:1337/announce,udp://tracker.auctor.tv:6969/announce,https://tracker.pmman.tech:443/announce}
EXTERNAL_PROXY_SERVICE_PORT=8090
EXTERNAL_PROXY_SERVICE_HOST=127.0.0.1
REDIS_MASTER_SERVICE_PORT=6379
REDIS_MASTER_SERVICE_HOST=127.0.0.1
TORRENT_WEB_SEEDER_SERVICE_PORT=8091
TORRENT_WEB_SEEDER_SERVICE_HOST=127.0.0.1
CONTENT_TRANSCODER_SERVICE_PORT=8092
CONTENT_TRANSCODER_SERVICE_HOST=127.0.0.1
TORRENT_ARCHIVER_SERVICE_PORT=8093
TORRENT_ARCHIVER_SERVICE_HOST=127.0.0.1
SRT2VTT_SERVICE_PORT=8094
SRT2VTT_SERVICE_HOST=127.0.0.1
TORRENT_HTTP_PROXY_SERVICE_PORT=8095
TORRENT_HTTP_PROXY_SERVICE_HOST=127.0.0.1
REST_API_SERVICE_PORT=8096
REST_API_SERVICE_HOST=127.0.0.1
WEB_UI_SERVICE_PORT=8097
WEB_UI_SERVICE_HOST=127.0.0.1
NGINX_VOD_SERVICE_PORT=8098
NGINX_VOD_SERVICE_HOST=127.0.0.1
NATS_SERVICE_HOST=127.0.0.1
NATS_SERVICE_PORT=4222
WEB_PORT=8080
USE_INTERNAL_TORRENT_HTTP_PROXY=true
USE_LOCALPG=${USE_LOCALPG:-true}
PGDATA_DIR=${PGDATA_DIR:-/pgdata}
PG_USER=${PG_USER:-app}
PG_PASSWORD=${PG_PASSWORD:-app}
PG_DATABASE=${PG_DATABASE:-app}
PG_HOST=${PG_HOST:-localhost}
PG_PORT=${PG_PORT:-5432}
VAULT_PG_DATABASE=${VAULT_PG_DATABASE:-vault}
USE_VAULT=${USE_VAULT:-true}
VAULT_SERVICE_HOST=127.0.0.1
VAULT_SERVICE_PORT=8100
# content-prober is reached two different ways, so it needs two pairs.
#
# CONTENT_PROBER_SERVICE_* is the platform-wide name for its gRPC endpoint --
# content-transcoder reads exactly these and dials gRPC (its own default is
# 50051). Pointing them at the HTTP port makes session creation answer 500,
# which is how this was found. 50051 itself is torrent-store's here, hence
# 50053.
CONTENT_PROBER_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_SERVICE_PORT=50053
# The HTTP endpoint, for the `~cp` matryoshka chain: web-ui asks through
# torrent-http-proxy for a file's media info before deciding whether the
# browser can play it directly or it has to be transcoded. Without it that
# step fails, and for a container that needs transcoding -- mkv, mostly --
# the failure is fatal, so playback stops at "probing content media info".
#
# The name is not decoration: torrent-http-proxy derives the variable it
# looks up from the `name` in its config by upper-casing it and turning
# dashes into underscores, so the entry there is `content-prober-http`.
CONTENT_PROBER_HTTP_SERVICE_HOST=127.0.0.1
CONTENT_PROBER_HTTP_SERVICE_PORT=8101

# torrent-http-proxy rejects a request whose client IP does not match the
# remoteAddress claim in its JWT, and the flag defaults to on. That premise --
# every request comes from the browser the token was minted for -- does not
# hold here: web-ui is itself a client of the proxy, and its server-side calls
# (the ~cp probe, warmup, stats) leave from 127.0.0.1 carrying the browser's
# token. Every one of them is a mismatch, answered 429, and the probe failure
# is fatal for anything that needs transcoding -- so mkv stopped at "probing
# content media info" while mp4, which never probes, played fine.
#
# Production runs it off too (helmfile values, enforceSessionIP: false).
# Overridable for an operator who fronts this with something that does make
# every request arrive from the client.
ENFORCE_SESSION_IP=${ENFORCE_SESSION_IP:-false}
VAULT_AWS_BUCKET=${VAULT_AWS_BUCKET:-vault}
GIN_MODE=release
DOMAIN=${DOMAIN:-http://localhost:8080}
ADMIN_PASSWORD=${ADMIN_PASSWORD:-}
ONLY_AUTHORIZED=${ONLY_AUTHORIZED:-true}
# Paired with the line above. /embed is exempt from the gate on purpose: a
# third-party iframe has no session here, so redirecting it to a login form
# would just render a broken player. Access is decided by the embed domain
# list on the profile page instead, and this is the flag that turns that list
# from "these domains see no ads" into "only these domains may embed".
EMBED_ONLY_AUTHORIZED=${EMBED_ONLY_AUTHORIZED:-true}
STREMIO_ADDON_USER_AGENT=${STREMIO_ADDON_USER_AGENT:-Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/80.0.3987.149 Safari/537.36}
# Scheduled jobs (subscription polling, cache-index cleanup, metadata
# enrichment, notification mail). Set to true on extra instances that share
# one database, so only one of them runs them.
DISABLE_CRON=${DISABLE_CRON:-false}
# AI recommendations quota. Upstream web-ui defaults the free-tier quota to 1,
# which makes sense where an upgrade is being sold; here there is no claims
# provider, every account is free-tier, and the Anthropic key belongs to the
# operator -- a 1/day cap is just a puzzling wall. Default to the paid-tier
# anti-abuse cap instead: no tier difference remains, and the limit only acts
# as a backstop against a runaway client loop burning the operator's API bill.
AI_RECOMMENDATIONS_FREE_DAILY_QUOTA=${AI_RECOMMENDATIONS_FREE_DAILY_QUOTA:-100}
# Mail. Optional and unset by default: with no SMTP_HOST web-ui builds no
# mail transport at all, and notifications are delivered to the in-app feed
# only -- nothing queues waiting for a relay. Setting a host is also what
# makes the profile's notification-address field appear, since an address
# can only be confirmed by mailing it a link. SMTP_FROM falls back to
# SMTP_USER when empty; SMTP_SECURE defaults to true (implicit TLS, which is
# what port 465 expects).
SMTP_HOST=${SMTP_HOST:-}
SMTP_PORT=${SMTP_PORT:-465}
SMTP_USER=${SMTP_USER:-}
SMTP_PASS=${SMTP_PASS:-}
SMTP_FROM=${SMTP_FROM:-}
SMTP_SECURE=${SMTP_SECURE:-true}
